# Backing 项目环境变量配置
# 复制此文件为 .env 并填入真实配置

# 数据库配置
# 开发环境可直接使用 sqlite；生产环境建议改为 MySQL
DATABASE_URL=sqlite:///./stock_backtest.db
# MySQL/非 SQLite 连接池上限（按并发需求调大；每个连接都有常驻内存成本）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# 如果使用 MySQL，可单独指定 bootstrap 库连接用于建库
# DB_BOOTSTRAP_URL=mysql+pymysql://user:password@localhost:3306

# 服务配置
HOST=0.0.0.0
PORT=8808
FRONTEND_ORIGIN=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
KLINE_PROVIDER=baostock
STOCK_LIST_PROVIDER=akshare
# mootdx 行情服务器，按优先级尝试；若失效或未指定且开启自动发现，将自动测速选优
MOOTDX_SERVERS=180.153.18.170:7709,180.153.18.171:7709,180.153.18.172:80
MOOTDX_TIMEOUT_S=3
MOOTDX_AUTO_DISCOVER=true
# 股票报价、指数快照和日/周/月 K 线分别选择 mootdx 或 tencent（HTTPS）
REALTIME_SNAPSHOT_PROVIDER=mootdx
# 腾讯返回最多 640 根不复权 K 线；历史成交额缺失时 amount=0
REALTIME_BARS_PROVIDER=mootdx
# 进程内行情缓存预算；超过任一上限会淘汰最旧记录
# REALTIME_MEMORY_CACHE_MAX_ENTRIES=512
# REALTIME_MEMORY_CACHE_MAX_BYTES=67108864

# DeepSeek / Tavily
DEEPSEEK_API_KEY=replace_me
TAVILY_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent 配置
AGENT_ORCHESTRATOR_MODE=standard
AGENT_MAX_STEPS=6
AGENT_ORCHESTRATOR_TIMEOUT_S=600
AGENT_MEMORY_ENABLED=false
AGENT_RISK_OVERRIDE=true

# Agent 聊天（backend 原生 runtime；fake 仅供测试/演示）
AGENT_CHAT_BACKEND=native
AGENT_CHAT_MAX_STEPS=6
AGENT_CHAT_TIMEOUT_S=600

# 代理配置（USE_PROXY=true 时必须填写下面两项）
USE_PROXY=false
# PROXY_HOST=
# PROXY_PORT=

# 策略优化保护阈值
MAX_OPTIMIZE_COMBINATIONS=200

# 后台任务执行
# threads = 进程内线程执行器（默认；开发/单实例）
# arq = 独立 worker + Redis（生产多实例），需设置 REDIS_URL 并执行
#       pip install -r requirements-arq.txt && python task_worker.py
TASK_BACKEND=threads
# 进程内线程执行器的最大并发任务数
# TASK_MAX_WORKERS=8
# Redis 仅用于可丢弃缓存；保持 TASK_BACKEND=threads 时不会启用 Arq。
# Redis 不可用时行情和研究自动降级到进程内缓存。
# REDIS_URL=redis://127.0.0.1:6379/1
# 瞬时失败（provider 不可用等）的最大重试次数与退避基数（秒）
# TASK_MAX_RETRIES=2
# TASK_RETRY_BACKOFF_S=5
# 执行租约时长与心跳间隔（秒）：租约过期视为执行者失联，任务可被回收
# TASK_LEASE_SECONDS=120
# TASK_HEARTBEAT_INTERVAL_S=15

# API 认证密钥（必填，用于保护所有 API 端点）
# 可以使用以下命令生成：python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_secret_api_key_here

# 浏览器登录账号（登录页使用账号 + 密码；密码以 PBKDF2 哈希存入 users 表，
# 启动时按此配置创建或更新）。AUTH_PASSWORD 留空时回退为使用 API_KEY 作为
# 初始密码，保证升级后仍可登录；两者都为空时浏览器登录不可用。
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me_with_a_strong_password

# 会话认证（登录成功后签发短期 HttpOnly session cookie）
# 生产环境（APP_ENV=production）：
#   1) 必须设置 SESSION_SECRET（可用 secrets.token_hex(32) 生成），否则拒绝启动
#   2) 必须设置 SESSION_HTTPS_ONLY=true（session cookie 仅经 HTTPS 发送）
#   3) 建议设置 SESSION_SAMESITE=lax（CSRF 由 double-submit token 校验）
# APP_ENV=development
# SESSION_SECRET=change_me_with_a_long_random_string
# SESSION_MAX_AGE_S=28800
# SESSION_SAMESITE=lax
# SESSION_HTTPS_ONLY=false

# 自选股列表（仪表盘显示）- 用逗号分隔股票代码
WATCHLIST_STOCKS=sh.600000,sh.600519,sh.601318,sh.000001,sz.000001,sz.399001,sz.399006

# 模拟盘服务端硬风控上限；客户端仅可进一步收紧，不能放宽。
# 未填写字段沿用 RiskLimits 默认值；配置非法时启动失败。
# PAPER_RISK_LIMITS={"max_single_weight":0.15,"max_gross_weight":0.8,"minimum_cash_weight":0.1,"max_position_loss":0.01,"max_portfolio_loss":0.05,"max_participation":0.05}
# PAPER_SOAK_ENABLED=true
# PAPER_SOAK_INTERVAL_S=60
