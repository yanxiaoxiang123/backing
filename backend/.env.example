# Backing 项目环境变量配置
# 复制此文件为 .env 并填入真实配置

# 数据库配置
# 开发环境可直接使用 sqlite；生产环境建议改为 MySQL
DATABASE_URL=sqlite:///./stock_backtest.db
# 如果使用 MySQL，可单独指定 bootstrap 库连接用于建库
# DB_BOOTSTRAP_URL=mysql+pymysql://user:password@localhost:3306

# 服务配置
HOST=0.0.0.0
PORT=8808
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KLINE_PROVIDER=baostock
STOCK_LIST_PROVIDER=akshare
# mootdx 行情服务器，按优先级尝试；可在网络环境变化时覆盖
MOOTDX_SERVERS=180.153.18.170:7709,180.153.18.171:7709,180.153.18.172:80
MOOTDX_TIMEOUT_S=3

# DeepSeek / Tavily
DEEPSEEK_API_KEY=replace_me
TAVILY_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Agent 配置
AGENT_ORCHESTRATOR_MODE=standard
AGENT_MAX_STEPS=6
AGENT_ORCHESTRATOR_TIMEOUT_S=600
AGENT_MEMORY_ENABLED=false
AGENT_RISK_OVERRIDE=true

# 代理配置（USE_PROXY=true 时必须填写下面两项）
USE_PROXY=false
# PROXY_HOST=
# PROXY_PORT=

# Agent 聊天（Harness 会话根目录；fake seam 先行，真实 SDK 装配见 dsh-quant-plugin/README.md）
DSH_SESSION_ROOT=backend/data/dsh_sessions

# 策略优化保护阈值
MAX_OPTIMIZE_COMBINATIONS=200

# 后台任务执行
# threads = 进程内线程执行器（默认；开发/单实例）
# arq = 独立 worker + Redis（生产多实例），需设置 REDIS_URL 并执行
#       pip install -r requirements-arq.txt && python task_worker.py
TASK_BACKEND=threads
# REDIS_URL=redis://localhost:6379/0
# 瞬时失败（provider 不可用等）的最大重试次数与退避基数（秒）
# TASK_MAX_RETRIES=2
# TASK_RETRY_BACKOFF_S=5
# 执行租约时长与心跳间隔（秒）：租约过期视为执行者失联，任务可被回收
# TASK_LEASE_SECONDS=120
# TASK_HEARTBEAT_INTERVAL_S=15

# API 认证密钥（必填，用于保护所有 API 端点）
# 可以使用以下命令生成：python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_secret_api_key_here

# 会话认证（前端登录页输入一次 API key 换取短期 HttpOnly session cookie）
# 生产环境（APP_ENV=production）：
#   1) 必须设置 SESSION_SECRET（可用 secrets.token_hex(32) 生成），否则拒绝启动
#   2) 必须设置 SESSION_HTTPS_ONLY=true（session cookie 仅经 HTTPS 发送）
#   3) 建议设置 SESSION_SAMESITE=lax（CSRF 由 double-submit token 校验）
# APP_ENV=development
# SESSION_SECRET=change_me_with_a_long_random_string
# SESSION_MAX_AGE_S=28800
# SESSION_SAMESITE=lax
# SESSION_HTTPS_ONLY=false

# 自选股列表（仪表盘显示）- 用逗号分隔股票代码
WATCHLIST_STOCKS=sh.600000,sh.600519,sh.601318,sh.000001,sz.000001,sz.399001,sz.399006
